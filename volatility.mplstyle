# volatility.mplstyle: shared look for every figure in this project
# Note: '#' starts a comment here, so hex colors are written WITHOUT the '#'.

figure.figsize   : 11, 4
figure.dpi       : 110

axes.spines.top    : False
axes.spines.right  : False
axes.edgecolor     : c3c2b7
axes.grid          : True
axes.titlesize     : 12
axes.titleweight   : bold
axes.labelcolor    : 52514e

grid.color      : e1e0d9
grid.linewidth  : 0.6

xtick.color : 898781
ytick.color : 898781

lines.linewidth : 1.4
legend.frameon  : False